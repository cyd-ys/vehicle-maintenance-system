# 应用配置（复制为 .env 后按需修改）
APP_NAME=汽车养护预约服务系统
DEBUG=true

# MySQL 8.0 连接串（如数据库不可用且 ALLOW_SQLITE_FALLBACK=true，将自动降级为 SQLite）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/vehicle_maintenance?charset=utf8mb4
ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=vehicle_maintenance.db

# JWT 安全参数：生产环境务必替换为足够长的随机字符串
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------- 邮箱注册（SMTP 发信） ----------------
# 留空时 DEBUG 模式启用本地调试模式：验证码回显在接口响应中，无需真实邮箱即可联调。
# 填写后注册/找回密码的验证码会真实发送到用户邮箱。
#   QQ 邮箱：SMTP_HOST=smtp.qq.com   SMTP_PORT=465 SMTP_USE_SSL=true
#             SMTP_PASSWORD 填「QQ邮箱-设置-账户」中生成的 SMTP 授权码（不是登录密码）
#   163 邮箱：SMTP_HOST=smtp.163.com  SMTP_PORT=465 SMTP_USE_SSL=true
#   企业微信邮：SMTP_HOST=smtp.exmail.qq.com SMTP_PORT=465 SMTP_USE_SSL=true
#   Gmail：   SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=汽车养护预约服务系统
SMTP_USE_SSL=true

EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_CODE_COOLDOWN_SECONDS=60
ALLOW_EMAIL_CODE_ECHO=true
